{
  "title": "CoolSynth Listening Pass",
  "intro": "Everything built since the 0.4.0 listening pass: the night of 19 to 20 November and the 808 circuit of the 20th. Each item was set up and played in the app through its MCP server first; the last line of each card says what it measured.",
  "bases": {
    "plain": [["load_preset", {"name": "Basic Saw"}], ["set_slot_type", {"slot": "pA.p1", "type": "Off"}]],
    "svf": [["load_preset", {"name": "Basic Saw"}], ["set_slot_type", {"slot": "pA.p1", "type": "SVF"}]]
  },
  "groups": [
    {"key": "kick", "title": "The Kick's 808, now its circuit", "intro": "Built on the 20th (D236): Werner's circuit in wave digital filters, close to SPICE and to Michael Fischer's recordings of a real 808. Each knob moves a part of the circuit."},
    {"key": "chip", "title": "The Chip generator", "intro": "Built on the night (D231): NES, Game Boy, SID 6581 and 8580, AY, YM and SCC in one generator. Built on Basic Saw with its filter taken out, so you hear the chip itself."},
    {"key": "arcade", "title": "Arcade, revoiced with the Chip", "intro": "Five Arcade sounds now play the chip instead of the VA; names, ideas and macros kept. Static Hit was already the NES noise and is unchanged."},
    {"key": "svf", "title": "The SVF: the SEM morph and the SID characters", "intro": "Built on the night (D233): an LP>HP mode with Morph, LP+BP and BP+HP, and Character (Clean, SID 6581, SID 8580) with Curve. Built on Basic Saw with the SVF in P1."},
    {"key": "small", "title": "Two small things", "intro": "A level fix and a tempo fix from the night."}
  ],
  "items": [
    {"id": "K1", "group": "kick", "title": "Succession 808",
     "setup": [["load_preset", {"name": "Succession 808"}]], "view": {},
     "play": [{"notes": [60], "hold": 1.6}, {"notes": [56], "hold": 1.6}, {"notes": [53], "hold": 1.6}, {"notes": [55], "hold": 2.4, "rel": 0.5}],
     "tries": [
