       {"label": "Hits on the ringing drum", "play": [{"notes": [60], "hold": 0.35}, {"notes": [60], "hold": 0.35}, {"notes": [60], "hold": 0.35}, {"notes": [60], "hold": 1.8, "rel": 0.3}]}
     ],
     "knobs": [
       {"pad": "Home", "page": "Macros", "knob": 1, "name": "Tone", "listen": "darker to brighter"},
       {"pad": "Home", "page": "Macros", "knob": 2, "name": "Punch", "listen": "a harder attack"},
       {"pad": "Home", "page": "Macros", "knob": 3, "name": "Boom", "listen": "a longer ring"},
       {"pad": "Home", "page": "Macros", "knob": 4, "name": "Grit", "listen": "more drive"}
     ],
     "listen": ["A deep boom (two octaves under the key) that jumps up for a few milliseconds, then sighs down almost three semitones onto the note.",
                "Mono: a new hit lands on the ringing drum without a click.",
                "Harder hits punch and sigh more than soft ones.",
                "Its level beside the other Engine Room sounds (levelled again on the 20th)."],
     "keys": "C4, A♭3, F3, G3",
     "pre": "Played at C4, A♭3, F3 and G3: peaks −13.7 to −14.4 dBFS, one voice, silent after release."},

