{
  "title": "CoolSynth Listening Pass",
  "intro": "Only what needs your ears, each with something to judge it against: ▶ Play against a try (a before and after), or a plain question with a few answers. What you passed on the 19th and 20th is left out (Chip, Arcade, the SVF, the stutter drafts, three noise presets). The kicks are mine first, measured against the real 808 and 909 recordings; the DAW checks are mine too.",
  "covers": [
    "Acid",
    "Succession 808",
    "Cut-Up Chords",
    "Wheel Stutter",
    "Glitch Pad",
    "Vinyl Choir",
    "Cassette Keys",
    "Blanket Pad",
    "Dusty Mallet",
    "Concrete Pad",
    "Washed Poly",
    "Pirate Radio",
    "Four-Track House",
    "Sea Pad"
  ],
  "bases": {
    "plain": [
      [
        "load_preset",
        {
          "name": "Basic Saw"
        }
      ],
      [
        "set_slot_type",
        {
          "slot": "pA.p1",
          "type": "Off"
        }
      ]
    ],
    "ladder": [
      [
        "load_preset",
        {
          "name": "Basic Saw"
        }
      ],
      [
        "set_slot_type",
        {
          "slot": "pA.p1",
          "type": "Ladder"
        }
      ],
      [
        "set_values",
        {
          "values": {
            "pA.voice.env2ToP1": "0 %",
            "pA.p1.p1": "800.0 Hz"
          }
        }
      ]
    ]
  },
  "groups": [
    {
      "key": "tb303",
      "title": "The TB-303",
      "intro": "Built on the 20th from Open303's engine (D242). Fixed today: Acid had a hidden Ladder filter after the 303 (its bank entry named no P1); it now plays the 303 alone, levelled again. Notes at velocity 100 or more are accented; overlapping notes slide."
    },
    {
      "key": "ladder",
      "title": "The Ladder by ear",
      "intro": "Item 13: four questions the measurements can't settle. Basic Saw through the Ladder at 800 Hz, nothing else moving it."
    },
    {
      "key": "noise",
      "title": "The added hiss and crackle",
      "intro": "Item 18: the presets with tape hiss or record crackle you haven't judged yet (Vinyl Choir, Concrete Pad and Pirate Radio passed on the 20th), each against itself with both at zero. Built on the 19th (D221): a steady level that mutes in silence."
    },
    {
      "key": "chip",
      "title": "Chip: the card left from the 20th",
      "intro": "You passed the rest of Chip, Arcade and the SVF on the 20th. This one was left unmarked."
    }
  ],
