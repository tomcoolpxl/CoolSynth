# The Museum's candidates: classic synth sounds rebuilt from their published settings
# (decisions D88, D103, D104). A sound moves from here into resources/presets/12-museum.csbank,
# and so into the plugin, when the user admits it in a side-by-side on the audition page.
# This folder is not built into the plugin.
#
# DX7 E.PIANO 1 was admitted on 13 November 2026 (decision D107), DX7 BASS 1 (D111), Prophet-5 Sync II and
# Brass (D115) and Minimoog Fat Bass (D118) on 14 November.
# TX81Z LatelyBass was admitted on 14 November 2026 (decision D119).
# Contact Opening I was admitted on 14 November 2026 (decision D121).
# Contact Opening II was admitted on 14 November 2026 (decision D125).
# The Fat Bass with the sizzle replaced the admitted Minimoog Fat Bass on 14 November 2026 (decision D128).
# Minimoog Trilogy Lead was admitted on 14 November 2026 (decision D130).

[Contact Opening II Grit]
room = Museum
# The twin of "Contact Opening II" (see resources/presets/12-museum.csbank) with the record's
# grit: the user found the original "slightly grittier". On the record the space between the
# sound's spectral lines holds a noise 43 to 45 dB under the strongest line of every band from
# 150 Hz to 8 kHz. The lossless "Contact" has the same floor as the compressed file of the 1981
# record, so it is in the recording itself (its tape, or the instrument), not added by a codec.
# The clean preset has 68 to 80 dB there. Driving the filter harder does not fill it (distortion
# lands on the lines); a white-noise generator in each voice does, through the voice's own
# filter and loudness contour, so it rides on every note. Its level is set where the rebuild's
# floor meets the record's.
g1 = VA shape=saw pan=-0.8 level=0.8
g2 = VA shape=saw fine=4 pan=0.8 level=0.8
g3 = Noise type=white level=0.2
p1 = Ladder cutoff=1800 res=0.05 key=0.35 drive=0 bass=0
env1 = attack=87.5 decay=1000 sustain=1 release=300 velocity=1
env2 = attack=10 decay=2940 sustain=0.65 release=2940 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.15 velToP1=0 drift=1
play = mode=poly voices=16 voiceSpread=1
master = 0

[Contact Opening II Grit A]
room = Museum
# Hiss, and each voice's loudness trembles at random, a new value 50 times a second (a
# sample-and-hold LFO on the VCA). Between the record's spectral lines lies something 40, 39
# and 37 dB under the strongest line of the bands 80-500 Hz, 500 Hz-2 kHz and 2-6 kHz, about
# the same in every band, and it is there only while the synth sounds (the recording before
# the first note is 50 dB quieter). Hiss alone gives 49, 43, 38: right at the top, 9 dB short
# at the bottom. Sidebands of a loudness that trembles are as strong against every line, low
# or high: this candidate measures 40.6, 39.8, 37.3.
g1 = VA shape=saw pan=-0.8 level=0.8
g2 = VA shape=saw fine=4 pan=0.8 level=0.8
g3 = Noise type=white level=0.2
p1 = Ladder cutoff=1800 res=0.05 key=0.35 drive=0 bass=0
env1 = attack=87.5 decay=1000 sustain=1 release=300 velocity=1
env2 = attack=10 decay=2940 sustain=0.65 release=2940 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.15 velToP1=0 drift=1
play = mode=poly voices=16 voiceSpread=1
lfo2 = shape=s&h rate=50 retrigger=off
mod = src=lfo2 dst=vca amount=0.25
master = -3.5

[Contact Opening II Grit B]
room = Museum
# As A with a rounder trembling (the smooth random LFO shape), a little deeper: 37.7, 38.5,
# 37.2 dB against the record's 40, 39, 37.
g1 = VA shape=saw pan=-0.8 level=0.8
g2 = VA shape=saw fine=4 pan=0.8 level=0.8
g3 = Noise type=white level=0.2
p1 = Ladder cutoff=1800 res=0.05 key=0.35 drive=0 bass=0
env1 = attack=87.5 decay=1000 sustain=1 release=300 velocity=1
env2 = attack=10 decay=2940 sustain=0.65 release=2940 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.15 velToP1=0 drift=1
play = mode=poly voices=16 voiceSpread=1
lfo2 = shape=smoothrandom rate=50 retrigger=off
mod = src=lfo2 dst=vca amount=0.4
master = -3.5

[Contact Opening II Grit C]
room = Museum
# Hiss, and the whole part slightly overdriven (the user's own guess: "a bit distortion
# possibly?"): a Drive effect in the part's first effect slot, where the chord is already
# summed, so its notes distort against each other as on a desk or a tape driven hard.
# 45.5, 39.6, 36.0 dB against the record's 40, 39, 37.
g1 = VA shape=saw pan=-0.8 level=0.8
g2 = VA shape=saw fine=4 pan=0.8 level=0.8
g3 = Noise type=white level=0.2
p1 = Ladder cutoff=1800 res=0.05 key=0.35 drive=0 bass=0
env1 = attack=87.5 decay=1000 sustain=1 release=300 velocity=1
env2 = attack=10 decay=2940 sustain=0.65 release=2940 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.15 velToP1=0 drift=1
play = mode=poly voices=16 voiceSpread=1
i1 = Drive amount=0.1 mix=1
master = -11

[Contact Opening II Grit D]
room = Museum
# The whole part overdriven more, without the hiss: 43.2, 37.2, 34.0 dB against the record's
# 40, 39, 37 (overdrive fills the top more than the bottom).
g1 = VA shape=saw pan=-0.8 level=0.8
g2 = VA shape=saw fine=4 pan=0.8 level=0.8
p1 = Ladder cutoff=1800 res=0.05 key=0.35 drive=0 bass=0
env1 = attack=87.5 decay=1000 sustain=1 release=300 velocity=1
env2 = attack=10 decay=2940 sustain=0.65 release=2940 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.15 velToP1=0 drift=1
play = mode=poly voices=16 voiceSpread=1
i1 = Drive amount=0.2 mix=1
master = -13.5

[Contact Opening II Grit E]
room = Museum
# Hiss, the trembling of A a little shallower, and a touch of the overdrive of C:
# 42.0, 39.5, 37.0 dB against the record's 40, 39, 37.
g1 = VA shape=saw pan=-0.8 level=0.8
g2 = VA shape=saw fine=4 pan=0.8 level=0.8
g3 = Noise type=white level=0.2
p1 = Ladder cutoff=1800 res=0.05 key=0.35 drive=0 bass=0
env1 = attack=87.5 decay=1000 sustain=1 release=300 velocity=1
env2 = attack=10 decay=2940 sustain=0.65 release=2940 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.15 velToP1=0 drift=1
play = mode=poly voices=16 voiceSpread=1
lfo2 = shape=s&h rate=50 retrigger=off
mod = src=lfo2 dst=vca amount=0.2
i1 = Drive amount=0.05 mix=1
master = -8.5
