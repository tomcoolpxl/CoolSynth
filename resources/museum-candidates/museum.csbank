# The Museum's candidates: classic synth sounds rebuilt from their published settings
# (decisions D88, D103, D104). A sound moves from here into resources/presets/12-museum.csbank,
# and so into the plugin, when the user admits it in a side-by-side on the audition page.
# This folder is not built into the plugin.
#
# DX7 E.PIANO 1 was admitted on 13 November 2026 (decision D107), DX7 BASS 1 (D111), Prophet-5 Sync II and
# Brass (D115) and Minimoog Fat Bass (D118) on 14 November.
# TX81Z LatelyBass was admitted on 14 November 2026 (decision D119).
# Contact Opening I was admitted on 14 November 2026 (decision D121).
# Contact Opening II was admitted on 14 November 2026 (decision D125).


[Minimoog Trilogy Lead]
room = Museum
# "Emerson, Lake and Palmer's Trilogy", from Tom Rhea's Sound Charts for the Minimoog (Moog
# Music, 1974, page 15). The chart: oscillator 2 at 2' and level 8 carries the tune; oscillators
# 1 and 3 at 16', three octaves under it, at level 2; all three on the square wave; filter
# cutoff -1, emphasis 6, amount of contour 3, both keyboard-control switches on; filter contour
# attack 0, decay 800 msec, sustain 0; loudness contour attack 0, decay 400 msec, sustain 10;
# glide at 5, decay switch on. One voice, the lowest key sounds.
# From the chart: ranges, levels, switches. From a recording of a real Model D set to this
# chart, measured and fitted:
# - the pulse width (that instrument's "square" is nearer a third than a half), the cutoff
#   (4.4 kHz at middle C), emphasis 6 (0.4), the contour's time and its reach (0.7 octave: the
#   chart's "amount of contour 3" is a small sweep);
# - the glide: the pitch slides into every note at a steady speed, about 5 ms a semitone going
#   up and 12 coming down (63 slides measured: a fifth up takes 22 ms, an octave up 60, a fifth
#   down 55). Glide by rate: 59 ms an octave, downward 2.4 times as long;
# - the filter's sweep takes about a hundredth of a second to come up (the shortest attack the
#   instrument has);
# - a note whose key is lifted falls about 115 dB a second: between detached notes of the
#   phrase the sound dips 7 to 14 dB before the next note starts.
# Three earlier versions were refused by the user's ear at "the beginning of a note", each time
# rightly: one joined notes that were struck, one had no glide at all (a measurement looked for
# the new pitch inside a band too narrow to see it travel), and none lifted a key before the
# next note, so no note began after a dip as the recording's do.
g1 = VA shape=pulse pw=0.3 oct=-1 level=0.15
g2 = VA shape=pulse pw=0.3 oct=2 level=0.8
g3 = VA shape=pulse pw=0.3 oct=-1 fine=3 level=0.15
p1 = Ladder cutoff=4412 res=0.405 key=1 drive=3 bass=0
env1 = attack=2 decay=1140 sustain=1 release=600 decayCurve=-1 releaseCurve=-1 velocity=0
env2 = attack=10 decay=3850 sustain=0 release=3850 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.07 velToP1=0 drift=1 glide=59 glideMode=rate glideDown=2.4
play = mode=legato priority=low
master = 0

[Minimoog Fat Bass Sizzle]
room = Museum
# The admitted "Minimoog Fat Bass" (see resources/presets/12-museum.csbank for the chart and
# what was fitted) with one thing more: the recording of the real Model D keeps a faint sizzle
# above 3 kHz through the whole note, about 60 dB under it, that a closed filter cannot leave.
# An analogue signal path lets a little of its oscillators past the filter; that is the
# ladder's Leak here (decision D122). Fitted with the comparison reaching 66 dB under the
# recording's level: a leak of 0.0045 (47 dB under the oscillators), and with it the fit wants
# less of oscillator 3's shake, 0.17 octave instead of 0.4. The bands above 2.8 kHz, which were
# 6.5, 11.5 and 23 dB short, are within 0.7, 1.3 and 3.6 dB.
# If the user admits this, it replaces the admitted preset under its name.
g1 = VA shape=saw oct=-2 level=0.8
g2 = VA shape=saw oct=-1 fine=3 level=0.8
g3 = VA shape=saw oct=-1 fine=-2 level=0.8
p1 = Ladder cutoff=902 res=0.06 key=1 drive=0 bass=0 fm=0.17 leak=0.0045
env1 = attack=1 decay=624 sustain=0.75 release=624 decayCurve=-1 releaseCurve=-1 velocity=0
env2 = attack=1 decay=450 sustain=0 release=450 decayCurve=-1 releaseCurve=-1
voice = env2ToP1=0.285 velToP1=0 drift=1
play = mode=legato priority=low
master = 0
