# Main Stage: modern, wide, processed. Most of this room waits for later modules.

[Reese]
room = Main Stage
g1 = VA shape=saw oct=-1 fine=7 pan=-0.25 level=0.8
g2 = VA shape=saw oct=-1 fine=-7 pan=0.25 level=0.8
p1 = Ladder cutoff=850 res=0.2 key=0.3 bass=0.6
env1 = attack=4 decay=200 sustain=1 release=140 velocity=0.3
voice = env2ToP1=0.06 glide=20
play = mode=legato glideLegato=on
drive = on amount=0.18 mix=0.75
master = -11.5

[Supersaw]
room = Main Stage
# Seven saws on the JP-8000 detune curve with the low end high-passed away by the
# state-variable filter at 120 Hz. The sub layer underneath arrives with parts in phase 7.2.
g1 = VA shape=saw unison=7 detune=50 spread=1 mix=0.75 rand=1 level=0.85
p1 = SVF mode=hp cutoff=120 res=0.1 key=0
p2 = Ladder cutoff=12000 res=0.05 key=0.3
env1 = attack=8 decay=500 sustain=0.9 release=420 velocity=0.5
voice = env2ToP1=0
reverb = on size=0.75 damping=0.45 mix=0.24
delay = on time=375 feedback=0.25 mix=0.12
master = -2.5

[Riser]
room = Main Stage
# Eight bars at the tempo (16 s at 120 BPM): the global envelope climbs an octave, opens the
# filter, widens the stack, brightens a wide noise layer and brings in a pulse that speeds up
# from 1/8 to 1/32. Hold a note or a chord.
g1 = VA shape=saw unison=7 detune=20 spread=0.8 mix=0.65 rand=1 level=0.85
g2 = Noise type=pink width=1 tone=0.35 level=0.25
p1 = Ladder cutoff=280 res=0.3 key=0 bass=0.5
env1 = attack=150 decay=500 sustain=1 release=1800
genv = attack=8bars attackCurve=0.4 sustain=1 release=1800 sync=on
lfo1 = shape=square sync=on division=1/8 retrigger=on
mod = src=genv dst=pitch amount=0.25
mod = src=genv dst=p1.cutoff amount=0.65
mod = src=genv dst=g1.detune amount=0.35
mod = src=genv dst=lfo1.rate amount=0.5
mod = src=lfo1 dst=vca amount=-0.6 curve=unipolar via=genv
mod = src=genv dst=g2.tone amount=0.6
mod = src=genv dst=g2.level amount=0.2
voice = env2ToP1=0
reverb = on size=0.85 damping=0.4 mix=0.3
master = -1.5

[Pluck Drop]
room = Main Stage
# A saw and pulse pluck whose pitch falls an octave in its first 40 ms, through a decaying
# filter, a synced eighth echo and a plate.
g1 = VA shape=saw level=0.7
g2 = VA shape=pulse pw=0.35 level=0.45
p1 = Ladder cutoff=900 res=0.25 key=0.6
env1 = attack=1 decay=600 sustain=0 release=300 velocity=0.5
env2 = attack=1 decay=260 sustain=0 release=200
env3 = attack=0.5 decay=40 sustain=0 release=40 decayCurve=-0.6
mod = src=env3 dst=pitch amount=0.25
voice = env2ToP1=0.45 velToP1=0.15
delay = on sync=on division=1/8 feedback=0.3 mix=0.18
reverb = on size=0.6 damping=0.4 mix=0.2
master = 4

[Hyper Lead]
room = Main Stage
# Three detuned saws whose pitch jumps to a random semitone every sixteenth (sample-and-hold,
# quantised), half crushed, into a synced ping-pong echo.
g1 = VA shape=saw unison=3 detune=20 spread=0.6 level=0.8
p1 = Ladder cutoff=3500 res=0.25 key=0.5
p2 = Crusher bits=7 rate=16000 mix=0.5
env1 = attack=2 decay=300 sustain=0.9 release=150
lfo1 = shape=s&h sync=on division=1/16 retrigger=on
mod = src=lfo1 dst=pitch amount=0.25 curve=quantized
voice = env2ToP1=0 glide=12
play = mode=legato
delay = on sync=on division=1/8. mode=pingpong feedback=0.35 mix=0.2
master = 5

[Neuro Growl]
room = Main Stage
# A digital wavetable and a sub-octave FM pair an octave down, talking through a formant filter
# whose vowel an LFO synced at 1/8 sweeps, then tube drive per voice and a resonant low-pass.
# The mod wheel doubles the talking rate.
g1 = Wavetable table=digital pos=0.35 oct=-1 level=1
g2 = FM2 ratio=0.5 index=0.6 feedback=0.2 oct=-1 level=0.75
p1 = Formant vowel=0 size=1.1 res=0.65 mix=1
p2 = Drive curve=tube drive=18 tone=0.8 mix=1
p3 = SVF mode=lp cutoff=2200 res=0.35 key=0.3
env1 = attack=2 decay=400 sustain=0.9 release=120
lfo1 = shape=triangle sync=on division=1/8 retrigger=on
mod = src=lfo1 dst=p1.vowel amount=0.5 curve=unipolar
mod = src=lfo1 dst=g1.pos amount=0.2
mod = src=wheel dst=lfo1.rate amount=0.25
voice = env2ToP1=0 glide=30
play = mode=legato glideLegato=on
master = 4.5

[Future Chord]
room = Main Stage
# One key plays a minor seventh chord: a wide stack of four soft wavetable voices on each of its
# notes, ducking on every quarter note and swelling back, the sidechain pump of future bass,
# chorused and brightened.
g1 = Wavetable table=classic pos=0.45 unison=4 detune=22 spread=1 level=0.85
p1 = SVF mode=lp cutoff=3200 res=0.15 key=0.4
env1 = attack=8 decay=700 sustain=0.75 release=450 velocity=0.4
env2 = attack=5 decay=500 sustain=0.3 release=400
mod = src=env2 dst=p1.cutoff amount=0.15
voice = env2ToP1=0 drift=2
chord = type=minor7
chorus = on rate=0.35 depth=0.45 mix=0.35
reverb = on size=0.6 damping=0.45 mix=0.22 predelay=20 lowcut=150
eq = on low=-1 tilt=0 high=2.5
pump = on depth=0.6 division=1/4 release=0.55
master = -1
