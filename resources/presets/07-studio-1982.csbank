# Studio 1982: clean polysynth classics with audible filter envelopes and light effects.
# Played, not produced: at most one or two effects per preset.

[Juno Pad]
room = Studio 1982
# One DCO's pulse and saw, as on the Juno-106: both start in phase, so every note has the same
# colour, and one global LFO sweeps the pulse width of every voice together, like the Juno's
# single LFO. Two of them are stacked the way a Jupiter's Dual mode stacks two patches: part A
# to the left, part B to the right, seven cents sharp with more saw and its own slower LFO.
# Chorus I-style slow chorus over both.
parts = stack
g1 = VA shape=pulse pw=0.5 rand=0 level=0.7
g2 = VA shape=saw rand=0 level=0.4
p1 = Ladder cutoff=1500 res=0.12 key=0.4 bass=0.5
env1 = attack=400 decay=1500 sustain=0.9 release=900 velocity=0.2
env2 = attack=600 decay=1800 sustain=0.6 release=900
glfo1 = shape=triangle sync=off rate=0.5 retrigger=off
mod = src=glfo1 dst=g1.pw amount=0.3
voice = env2ToP1=0.06 drift=3
mix = pan=-0.4
b.g1 = VA shape=pulse pw=0.45 rand=0 level=0.5
b.g2 = VA shape=saw rand=0 level=0.6
b.p1 = Ladder cutoff=1700 res=0.1 key=0.4 bass=0.5
b.env1 = attack=550 decay=1500 sustain=0.9 release=1100 velocity=0.2
b.env2 = attack=800 decay=1800 sustain=0.6 release=1000
b.glfo1 = shape=triangle sync=off rate=0.37 retrigger=off
b.mod = src=glfo1 dst=g1.pw amount=0.25
b.voice = env2ToP1=0.06 drift=3
b.mix = pan=0.4 fine=7 level=-1.5
f1 = Chorus rate=0.5 depth=0.55 mix=0.5
f2 = Reverb size=0.55 damping=0.5 mix=0.15
master = -11
# Macros (drafted 2026-11-15 for the user's review, D177): Bright, Resonance, Swell, Swirl
macros = names=Bright,Resonance,Swell,Swirl
b.macros = names=Bright,Resonance,Swell,Swirl
mod = src=macro1 dst=p1.cutoff amount=0.15
mod = src=macro2 dst=p1.res amount=0.3
mod = src=macro3 dst=env1.time amount=0.25
mod = src=macro3 dst=env2.time amount=0.25
mod = src=glfo1 dst=g1.pw amount=0.1 via=macro4
b.mod = src=macro1 dst=p1.cutoff amount=0.15
b.mod = src=macro2 dst=p1.res amount=0.3
b.mod = src=macro3 dst=env1.time amount=0.25
b.mod = src=macro3 dst=env2.time amount=0.25
b.mod = src=glfo1 dst=g1.pw amount=0.1 via=macro4
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro3 dst=f2.size amount=0.1
fx = src=macro4 dst=f1.rate amount=0.08
fx = src=macro4 dst=f1.depth amount=0.15
b.fx = src=macro3 dst=f2.size amount=0.1
b.fx = src=macro4 dst=f1.rate amount=0.08
b.fx = src=macro4 dst=f1.depth amount=0.15

[Prophet Brass]
room = Studio 1982
g1 = VA shape=saw fine=-3 level=0.75
g2 = VA shape=saw fine=3 level=0.75
p1 = Ladder cutoff=650 res=0.15 key=0.5 bass=0.6
env1 = attack=25 decay=450 sustain=0.85 release=280 velocity=0.6
env2 = attack=70 decay=650 sustain=0.4 release=300
voice = env2ToP1=0.36 velToP1=0.1 drift=3
play = voices=8
i1 = Reverb size=0.45 damping=0.55 mix=0.12
mix = level=-11
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Blare, Bite, Swell, Vibrato
macros = names=Blare,Bite,Swell,Vibrato
mod = src=macro1 dst=p1.cutoff amount=0.15
mod = src=env2 dst=p1.cutoff amount=0.15 via=macro2
mod = src=macro3 dst=env1.time amount=0.3
mod = src=macro3 dst=env2.time amount=0.3
mod = src=lfo1 dst=pitch amount=0.005 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.35

[OB Strings]
room = Studio 1982
g1 = VA shape=saw fine=-6 pan=-0.3 level=0.7
g2 = VA shape=saw fine=6 pan=0.3 level=0.7
p1 = Ladder mode=lp12 cutoff=2600 res=0.1 key=0.5
env1 = attack=550 decay=900 sustain=1 release=900 velocity=0.3
env2 = attack=400 decay=1500 sustain=0.6 release=900
voice = env2ToP1=0.08 drift=4
i1 = Phaser rate=0.25 depth=0.6
i2 = Reverb size=0.65 damping=0.5 mix=0.22
mix = level=-9.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Sheen, Ensemble, Swell, Vibrato
macros = names=Sheen,Ensemble,Swell,Vibrato
mod = src=macro1 dst=p1.cutoff amount=0.15
mod = src=macro2 dst=g1.pitch amount=-0.0008
mod = src=macro2 dst=g2.pitch amount=0.0008
mod = src=macro3 dst=env1.time amount=0.25
mod = src=macro3 dst=env2.time amount=0.25
mod = src=lfo1 dst=pitch amount=0.004 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.3
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro2 dst=i1.depth amount=0.25
fx = src=macro3 dst=i2.size amount=0.1

[Moog Bass]
room = Studio 1982
g1 = VA shape=saw sub=0.5 level=0.8
g2 = VA shape=saw oct=-1 fine=3 level=0.5
p1 = Ladder cutoff=330 res=0.35 key=0.3 drive=4 bass=0.7
env1 = attack=1 decay=400 sustain=0.9 release=80 velocity=0.4
env2 = attack=1 decay=280 sustain=0.15 release=120
voice = env2ToP1=0.36 velToP1=0.15 glide=30
play = mode=legato priority=low glideLegato=on
mix = level=-6.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Open, Growl, Decay, Wobble
macros = names=Open,Growl,Decay,Wobble
mod = src=macro1 dst=p1.cutoff amount=0.15
mod = src=macro2 dst=p1.drive amount=0.3
mod = src=macro2 dst=p1.res amount=0.15
mod = src=macro3 dst=env1.time amount=0.3
mod = src=macro3 dst=env2.time amount=0.3
mod = src=lfo1 dst=p1.cutoff amount=0.06 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.25

[Clav Keys]
room = Studio 1982
g1 = VA shape=pulse pw=0.28 level=0.8
p1 = Ladder cutoff=1500 res=0.3 key=1
p2 = Ladder mode=hp12 cutoff=160 res=0
env1 = attack=0.5 decay=320 sustain=0.2 release=70 velocity=0.8 decayCurve=-0.8
env2 = attack=0.5 decay=110 sustain=0 release=80 decayCurve=-0.8
voice = env2ToP1=0.32 velToP1=0.2
i1 = Drive amount=0.12 mix=0.6
mix = level=-7
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Treble, Quack, Decay, Wah
macros = names=Treble,Quack,Decay,Wah
mod = src=macro1 dst=p1.cutoff amount=0.12
mod = src=macro2 dst=p1.res amount=0.2
mod = src=macro2 dst=g1.pw amount=-0.12
mod = src=macro3 dst=env1.time amount=0.3
mod = src=macro3 dst=env2.time amount=0.3
mod = src=lfo1 dst=p1.cutoff amount=0.1 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.25

[Sync Lead]
room = Studio 1982
# G1 is the silent master; G2 is synced to it a fifth and a bit higher. The filter envelope
# also sweeps the slave's pitch down from two octaves above, the Prophet-5 poly-mod sync sweep.
g1 = VA shape=saw level=0
g2 = VA shape=saw combine=sync semi=7 fine=30 level=0.85
g3 = VA shape=saw oct=-1 level=0.3
p1 = Ladder cutoff=3600 res=0.2 key=0.5
env1 = attack=3 decay=300 sustain=1 release=160
env2 = attack=2 decay=700 sustain=0.25 release=200
mod = src=env2 dst=g2.pitch amount=0.5
voice = env2ToP1=0.22 glide=45
play = mode=mono
i1 = Delay time=330 feedback=0.3 mix=0.18
i2 = Reverb size=0.4 damping=0.5 mix=0.1
mix = level=-1.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Edge, Zap, Sweep, Vibrato
macros = names=Edge,Zap,Sweep,Vibrato
mod = src=macro1 dst=g2.pitch amount=0.125
mod = src=macro1 dst=p1.cutoff amount=0.06
mod = src=env2 dst=g2.pitch amount=0.2 via=macro2
mod = src=macro3 dst=env2.time amount=0.3
mod = src=macro3 dst=env1.time amount=0.2
mod = src=lfo1 dst=pitch amount=0.006 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.4
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro3 dst=i1.feedback amount=0.2

[Ladder Chords]
room = Studio 1982
# Kept from the listening pass at the user's word (2026-11-21): one saw through the ladder at 800 Hz with
# a little resonance, the key opening it as you play higher, nothing else; chords come out warm and round.
# Drive is the first macro, clean at zero as heard, up to 24 dB of the ladder's own grit. Full Drive is
# about 7 dB louder, kept by the user's choice over the bank's 4 dB rule for macros (D177, 2026-11-21).
g1 = VA shape=saw level=0.8
p1 = Ladder cutoff=800 res=0.3 key=0.5 bass=0.5
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
mix = level=-11
master = 3
macros = names=Drive,Cutoff,Resonance,Release
mod = src=macro1 dst=p1.drive amount=1
mod = src=macro2 dst=p1.cutoff amount=0.3
mod = src=macro3 dst=p1.res amount=0.5
mod = src=macro4 dst=env1.time amount=0.75
