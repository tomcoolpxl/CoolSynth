# Studio 1982: clean polysynth classics with audible filter envelopes and light effects.
# Played, not produced: at most one or two effects per preset.

[Juno Pad]
room = Studio 1982
# One DCO's pulse and saw, as on the Juno-106: both start in phase, so every note has the same
# colour, and one global LFO sweeps the pulse width of every voice together, like the Juno's
# single LFO. Two of them are stacked the way a Jupiter's Dual mode stacks two patches: part A
# to the left, part B to the right, seven cents sharp with more saw and its own slower LFO.
# Chorus I-style slow chorus over both.
parts = layer
g1 = VA shape=pulse pw=0.5 rand=0 level=0.7
g2 = VA shape=saw rand=0 level=0.4
p1 = Ladder cutoff=1500 res=0.12 key=0.4 bass=0.5
env1 = attack=400 decay=1500 sustain=0.9 release=900 velocity=0.2
env2 = attack=600 decay=1800 sustain=0.6 release=900
glfo1 = shape=triangle sync=off rate=0.5 retrigger=off
mod = src=glfo1 dst=g1.pw amount=0.3
voice = env2ToP1=0.06 drift=3
mix = pan=-0.4
b.g1 = VA shape=pulse pw=0.45 rand=0 level=0.5
b.g2 = VA shape=saw rand=0 level=0.6
b.p1 = Ladder cutoff=1700 res=0.1 key=0.4 bass=0.5
b.env1 = attack=550 decay=1500 sustain=0.9 release=1100 velocity=0.2
b.env2 = attack=800 decay=1800 sustain=0.6 release=1000
b.glfo1 = shape=triangle sync=off rate=0.37 retrigger=off
b.mod = src=glfo1 dst=g1.pw amount=0.25
b.voice = env2ToP1=0.06 drift=3
b.mix = pan=0.4 fine=7 level=-1.5
f1 = Chorus rate=0.5 depth=0.55 mix=0.5
f2 = Reverb size=0.55 damping=0.5 mix=0.15
master = -5

[Prophet Brass]
room = Studio 1982
g1 = VA shape=saw fine=-3 level=0.75
g2 = VA shape=saw fine=3 level=0.75
p1 = Ladder cutoff=650 res=0.15 key=0.5 bass=0.6
env1 = attack=25 decay=450 sustain=0.85 release=280 velocity=0.6
env2 = attack=70 decay=650 sustain=0.4 release=300
voice = env2ToP1=0.36 velToP1=0.1 drift=3
play = voices=8
f1 = Reverb size=0.45 damping=0.55 mix=0.12
master = -5

[OB Strings]
room = Studio 1982
g1 = VA shape=saw fine=-6 pan=-0.3 level=0.7
g2 = VA shape=saw fine=6 pan=0.3 level=0.7
p1 = Ladder mode=lp12 cutoff=2600 res=0.1 key=0.5
env1 = attack=550 decay=900 sustain=1 release=900 velocity=0.3
env2 = attack=400 decay=1500 sustain=0.6 release=900
voice = env2ToP1=0.08 drift=4
f1 = Phaser rate=0.25 depth=0.6
f2 = Reverb size=0.65 damping=0.5 mix=0.22
master = -4.5

[Moog Bass]
room = Studio 1982
g1 = VA shape=saw sub=0.5 level=0.8
g2 = VA shape=saw oct=-1 fine=3 level=0.5
p1 = Ladder cutoff=330 res=0.35 key=0.3 drive=4 bass=0.7
env1 = attack=1 decay=400 sustain=0.9 release=80 velocity=0.4
env2 = attack=1 decay=280 sustain=0.15 release=120
voice = env2ToP1=0.36 velToP1=0.15 glide=30
play = mode=legato priority=low glideLegato=on
master = -1.5

[Clav Keys]
room = Studio 1982
g1 = VA shape=pulse pw=0.28 level=0.8
p1 = Ladder cutoff=1500 res=0.3 key=1
p2 = Ladder mode=hp12 cutoff=160 res=0
env1 = attack=0.5 decay=320 sustain=0.2 release=70 velocity=0.8 decayCurve=-0.8
env2 = attack=0.5 decay=110 sustain=0 release=80 decayCurve=-0.8
voice = env2ToP1=0.32 velToP1=0.2
f1 = Drive amount=0.12 mix=0.6
master = -2

[Sync Lead]
room = Studio 1982
# G1 is the silent master; G2 is synced to it a fifth and a bit higher. The filter envelope
# also sweeps the slave's pitch down from two octaves above, the Prophet-5 poly-mod sync sweep.
g1 = VA shape=saw level=0
g2 = VA shape=saw combine=sync semi=7 fine=30 level=0.85
g3 = VA shape=saw oct=-1 level=0.3
p1 = Ladder cutoff=3600 res=0.2 key=0.5
env1 = attack=3 decay=300 sustain=1 release=160
env2 = attack=2 decay=700 sustain=0.25 release=200
mod = src=env2 dst=g2.pitch amount=0.5
voice = env2ToP1=0.22 glide=45
play = mode=mono
f1 = Delay time=330 feedback=0.3 mix=0.18
f2 = Reverb size=0.4 damping=0.5 mix=0.1
master = 2.5
