# Basement: dark industrial and techno. Distortion and resonance, low, menacing, metallic;
# sweeps that scream. Nothing pretty. Room rule: drive or fold on every preset.

[Acid]
room = Basement
# The squelch: a saw an octave down through a resonant, driven ladder that its envelope snaps
# open. Harder notes accent the filter; overlapping notes slide.
g1 = VA shape=saw oct=-1 level=0.85
p1 = Ladder cutoff=280 res=0.75 drive=8 key=0.3 bass=0.6
env1 = attack=1 decay=200 sustain=0.6 release=60
env2 = attack=1 decay=200 sustain=0 release=80 decayCurve=-0.7
voice = env2ToP1=0.55 velToP1=0.3 glide=40
play = mode=legato glideLegato=on
f1 = Drive amount=0.3 mix=0.7
master = -10.5
# Macros (drafted 2026-11-15 for the user's review, D177): Cutoff, Squelch, Decay, Wobble
macros = names=Cutoff,Squelch,Decay,Wobble
mod = src=macro1 dst=p1.cutoff amount=0.15
mod = src=macro2 dst=p1.res amount=0.12
mod = src=macro2 dst=p1.drive amount=0.25
mod = src=macro3 dst=env1.time amount=0.3
mod = src=macro3 dst=env2.time amount=0.3
mod = src=lfo1 dst=p1.cutoff amount=0.1 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.25

[Rust Bass]
room = Basement
# A saw and a pulse an octave down, folded per voice harder as each note's envelope opens, then
# a ladder takes the fizz off.
g1 = VA shape=saw oct=-1 level=0.7
g2 = VA shape=pulse pw=0.3 oct=-1 level=0.45
p1 = Folder drive=6 sym=0.15 mix=1
p2 = Ladder cutoff=900 res=0.2 key=0.4 bass=0.7
env1 = attack=1 decay=500 sustain=0.8 release=90
env3 = attack=1 decay=350 sustain=0.2 release=150
mod = src=env3 dst=p1.drive amount=0.45
mod = src=velocity dst=p1.drive amount=0.15
voice = env2ToP1=0
play = mode=mono
f1 = Drive amount=0.15 mix=0.5
master = -13
# Macros (drafted 2026-11-15 for the user's review, D177): Fizz, Fold, Decay, Churn
macros = names=Fizz,Fold,Decay,Churn
mod = src=macro1 dst=p2.cutoff amount=0.15
mod = src=macro2 dst=p1.drive amount=0.25
mod = src=macro2 dst=p1.sym amount=0.1
mod = src=macro3 dst=env1.time amount=0.3
mod = src=macro3 dst=env3.time amount=0.3
mod = src=lfo1 dst=p1.sym amount=0.2 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.25

[Metal Hit]
room = Basement
# A saw ring-modulated by a second saw at the inharmonic ratio 2.76 (17.58 semitones up), hard
# driven per voice and cut short: a clang that never settles into a pitch.
g1 = VA shape=saw level=0.25
g2 = VA shape=saw combine=ring amount=1 oct=1 semi=6 fine=-42 level=0.8
p1 = Drive curve=hard drive=14 tone=0.8 mix=1
p2 = Ladder cutoff=4500 res=0.2 key=0.5
env1 = attack=0.5 decay=250 sustain=0 release=200 velocity=0.5
voice = env2ToP1=0
f1 = Reverb size=0.3 damping=0.4 mix=0.2
master = 0.5
# Macros (drafted 2026-11-15 for the user's review, D177): Sizzle, Crunch, Length, Shudder
macros = names=Sizzle,Crunch,Length,Shudder
mod = src=macro1 dst=p2.cutoff amount=0.12
mod = src=macro1 dst=p1.tone amount=0.2
mod = src=macro2 dst=p1.drive amount=0.06
mod = src=macro2 dst=p2.res amount=0.1
mod = src=macro3 dst=env1.time amount=0.2
mod = src=lfo1 dst=g2.pitch amount=0.03 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.5

[Furnace Drone]
room = Basement
# Two saws two octaves down, nine cents apart, with a rumble of dark noise, through a resonant
# comb whose tuning a slow global LFO drags up and down a fifth, then a soft per-voice drive.
g1 = VA shape=saw oct=-2 level=0.6
g2 = VA shape=saw oct=-2 fine=-9 level=0.6
g3 = Noise type=pink tone=0.25 level=0.15
p1 = Comb tune=12 fb=0.85 damp=0.3 key=1 mix=0.6
p2 = Drive curve=soft drive=10 tone=0.6 mix=1
p3 = Ladder cutoff=1800 res=0.1 key=0.3
env1 = attack=2000 decay=2000 sustain=1 release=3000
glfo1 = shape=sine sync=off rate=0.05 retrigger=off
mod = src=glfo1 dst=p1.tune amount=0.15
voice = env2ToP1=0 drift=5
f1 = Reverb size=0.7 damping=0.6 mix=0.2
master = -11
# Macros (drafted 2026-11-15 for the user's review, D177): Glow, Roar, Swell, Sweep
macros = names=Glow,Roar,Swell,Sweep
mod = src=macro1 dst=p3.cutoff amount=0.15
mod = src=macro2 dst=p2.drive amount=0.25
mod = src=macro2 dst=p1.fb amount=0.06
mod = src=macro3 dst=env1.time amount=0.25
mod = src=glfo1 dst=p1.tune amount=0.1 via=macro4
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro3 dst=f1.size amount=0.1

[Concrete Pad]
room = Basement
# Two detuned saws with the bass taken away (state-variable high-pass at 200 Hz) and the top too
# (ladder at 1 kHz), crushed to 12 bits at 22 kHz, then run through a dirty tape.
g1 = VA shape=saw fine=-8 level=0.7
g2 = VA shape=saw fine=8 level=0.7
p1 = SVF mode=hp cutoff=200 res=0.1 key=0
p2 = Ladder cutoff=1000 res=0.15 key=0.3
p3 = Crusher bits=12 rate=22000 mix=1
env1 = attack=600 decay=1500 sustain=1 release=1500
voice = env2ToP1=0 drift=4
f1 = Drive amount=0.15 mix=0.5
f2 = LoFi wow=0.25 hiss=0.25 crackle=0.15 bandwidth=0.7 flutter=0
f3 = Reverb size=0.6 damping=0.6 mix=0.2
master = -13.5
# Macros (drafted 2026-11-15 for the user's review, D177): Daylight, Crush, Swell, Sway
macros = names=Daylight,Crush,Swell,Sway
mod = src=macro1 dst=p2.cutoff amount=0.15
mod = src=macro2 dst=p3.bits amount=-0.25
mod = src=macro2 dst=p3.rate amount=-0.15
mod = src=macro3 dst=env1.time amount=0.3
mod = src=lfo1 dst=p2.cutoff amount=0.08 via=macro4
mod = src=macro4 dst=lfo1.rate amount=-0.5
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro2 dst=f2.crackle amount=0.15
fx = src=macro3 dst=f3.size amount=0.1
fx = src=macro4 dst=f2.wow amount=0.3

[Siren]
room = Basement
# No oscillator at all: the ladder sings at full resonance from its own noise floor while a
# slow global saw LFO drags its cutoff up, into a long, overdriven echo.
g1 = Off
p1 = Ladder cutoff=500 res=1 key=0 drive=6
env1 = attack=40 decay=500 sustain=1 release=1500
glfo1 = shape=sawUp sync=off rate=0.1 retrigger=on
mod = src=glfo1 dst=p1.cutoff amount=0.3
voice = env2ToP1=0
play = mode=mono
f1 = Drive amount=0.2 mix=0.6
f2 = Delay time=375 feedback=0.8 mix=0.3
master = -4.5
# Macros (drafted 2026-11-15 for the user's review, D177): Scream, Snarl, Fade, Wail
macros = names=Scream,Snarl,Fade,Wail
mod = src=macro1 dst=p1.cutoff amount=0.1
mod = src=macro2 dst=p1.drive amount=0.35
mod = src=macro3 dst=env1.time amount=0.3
mod = src=lfo1 dst=p1.cutoff amount=0.04 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.35
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro3 dst=f2.feedback amount=0.05
