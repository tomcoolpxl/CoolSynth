# Greenhouse: glass, bells, mallets and strings. Percussive attacks, inharmonic or sine-rich
# decays, organic. Room rule: sustain level 0 everywhere.

[Glass Bell]
room = Greenhouse
# A ratio-3.5 FM bell whose index falls over two seconds, so the clang melts into a pure tone,
# with a quieter, slightly detuned high partial for shimmer. Harder playing rings brighter.
g1 = FM2 ratio=3.5 index=0.4 level=0.8
g2 = FM2 ratio=5 carrier=2 index=0.3 fine=7 level=0.22
p1 = Off
env1 = attack=1 decay=3500 sustain=0 release=2500 decayCurve=-0.7 velocity=0.5
env3 = attack=1 decay=2000 sustain=0 release=1500
mod = src=env3 dst=g1.index amount=0.45
mod = src=velocity dst=g1.index amount=0.15
mod = src=env3 dst=g2.index amount=0.3
voice = env2ToP1=0
reverb = on size=0.75 damping=0.4 mix=0.3
master = -2.5

[Rain Chime]
room = Greenhouse
# High sine and triangle plucks, two octaves up, falling at random over three octaves at 1/16
# with every other step skipped on average, into a ping-pong echo and a long room.
g1 = VA shape=sine oct=2 rand=0 level=0.75
g2 = VA shape=triangle oct=2 fine=5 level=0.35
p1 = Off
env1 = attack=1 decay=300 sustain=0 release=250 velocity=0.5
voice = env2ToP1=0
arp = on rate=1/16 pattern=random octaves=3 gate=0.6 chance=0.5
delay = on sync=on division=1/8. mode=pingpong feedback=0.35 mix=0.25
reverb = on size=0.7 damping=0.35 mix=0.3
master = 6

[Crystal Pluck]
room = Greenhouse
# A saw and a pulse an octave up through a resonant ladder that snaps shut in 180 ms and follows
# the key fully, so every note is equally bright.
g1 = VA shape=saw level=0.7
g2 = VA shape=pulse pw=0.3 oct=1 level=0.4
p1 = Ladder cutoff=600 res=0.3 key=1
env1 = attack=1 decay=700 sustain=0 release=400 velocity=0.5
env2 = attack=0.5 decay=180 sustain=0 release=150
voice = env2ToP1=0.5 velToP1=0.12
reverb = on size=0.6 damping=0.45 mix=0.22
master = 4

[Kalimba]
room = Greenhouse
# A steel tine clamped at one end, as a kalimba's is: the note, and far above it the tine's own
# overtones at 6.3 and 17.5 times its pitch, which no string has. It rings about three seconds
# and sounds an octave above the key, with a five-millisecond puff of noise for the thumb.
g1 = Modal material=tine decay=3 hard=0.15 pos=0.3 damp=0.2 release=0 oct=1 level=0.9
g2 = Noise type=white tone=0.7 level=0
p1 = Off
env1 = attack=1 decay=12000 sustain=0 release=3000 velocity=0.5
env3 = attack=0.5 decay=5 sustain=0 release=5
mod = src=env3 dst=g2.level amount=0.35
mod = src=velocity dst=g1.hard amount=0.2
mod = src=key dst=g1.decay amount=-0.4
voice = env2ToP1=0
reverb = on size=0.45 damping=0.5 mix=0.2 predelay=10
master = -1

[Harp String]
room = Greenhouse
# A string plucked at its middle with the pad of a finger, as a harpist plucks: a round, dark
# note that is almost a pure tone a second after the pluck, with the finger's noise at its start.
# Set from a recorded concert harp, harmonic by harmonic at three moments of each note: the
# pluck is softer and nearer the middle the higher the string, the upper harmonics die several
# times faster than the note itself (more so in the bass strings), the bass rings for ten
# seconds and the treble for two. Letting go lays a hand on the string; harder playing plucks
# a little brighter. The reverb is at its shortest: the recording's room is a small one.
g1 = String decay=5.2 damp=0.52 pick=0.23 pos=0.47 release=0.75 level=0.9 excite=click
g2 = Noise type=pink tone=0.6 level=0
p1 = Off
env1 = attack=1 decay=16000 sustain=0 release=450 velocity=0.5
env3 = attack=0.5 decay=25 sustain=0 release=25
mod = src=env3 dst=g2.level amount=0.6
mod = src=velocity dst=g1.pick amount=0.15
mod = src=key dst=g1.decay amount=-0.425
mod = src=key dst=g1.pick amount=-1
mod = src=key dst=g1.damp amount=-0.96
mod = src=key dst=g1.pos amount=0.12
voice = env2ToP1=0 drift=1
reverb = on size=0 damping=0.5 mix=0.25 predelay=0
master = -2

[Marimba]
room = Greenhouse
# A tuned wooden bar, set from a recorded marimba: the fundamental, its partner exactly two
# octaves up and a third partial a little over three octaves up, each ringing in proportion to
# its period. The bar rings four seconds at middle C, half as long an octave higher and twice as
# long an octave lower. Playing harder makes the mallet harder, and a few milliseconds of noise
# at the note's pitch are its knock.
g1 = Modal material=wood decay=4 hard=0.1 pos=0.3 damp=0 release=0 level=0.9
g2 = Noise type=band res=0.2 tone=0.8 level=0
p1 = Off
env1 = attack=0.5 decay=16000 sustain=0 release=4000 velocity=0.6
env3 = attack=0.5 decay=8 sustain=0 release=8
mod = src=velocity dst=g1.hard amount=0.45
mod = src=key dst=g1.decay amount=-0.7
mod = src=env3 dst=g2.level amount=0.25
voice = env2ToP1=0
reverb = on size=0.4 damping=0.55 mix=0.16 predelay=8
master = -0.5
