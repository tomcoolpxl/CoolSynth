# Observatory: space and ambient. Slow swells, wide stereo, long tails, no hurry.

[Solar Wind]
room = Observatory
# Two resonant noise bands that ignore the key, each drifting on its own slow global LFO across
# two octaves, wide in stereo, swelling in over three seconds into a long plate.
g1 = Noise type=band res=0.7 width=1 key=off oct=1 level=0.6
g2 = Noise type=band res=0.6 width=1 key=off oct=2 pan=0.2 level=0.35
p1 = Off
env1 = attack=3000 decay=2000 sustain=1 release=4000
glfo1 = shape=sine sync=off rate=0.07 retrigger=off
glfo2 = shape=sine sync=off rate=0.045 phase=120 retrigger=off
mod = src=glfo1 dst=g1.pitch amount=0.5
mod = src=glfo2 dst=g2.pitch amount=0.35
voice = env2ToP1=0
reverb = on size=0.9 damping=0.35 mix=0.4
master = -4.5

[Nebula Pad]
room = Observatory
# Two wavetable stacks drifting through their tables on slow per-voice LFOs (20 and 27 s a
# cycle), so every note's timbre wanders on its own: vocal formants under a sync-swept digital
# shimmer, through a soft state-variable low-pass into a large plate after 80 ms of pre-delay.
g1 = Wavetable table=vocal pos=0.5 unison=3 detune=14 spread=0.8 level=0.7
g2 = Wavetable table=digital pos=0.25 unison=2 detune=10 spread=1 level=0.28
p1 = SVF mode=lp cutoff=2600 res=0.12 key=0.4
env1 = attack=2000 decay=2000 sustain=1 release=4000
lfo1 = shape=sine rate=0.05 retrigger=off
lfo2 = shape=sine rate=0.037 retrigger=off
mod = src=lfo1 dst=g1.pos amount=0.5
mod = src=lfo2 dst=g2.pos amount=0.25
voice = env2ToP1=0 drift=3
chorus = on rate=0.3 depth=0.35 mix=0.25
reverb = on size=0.9 damping=0.4 mix=0.38 predelay=80 lowcut=80
master = -1.5

[Deep Field]
room = Observatory
# A saw two octaves down and a sine one octave down under a dark ladder whose cutoff breathes
# on a 20-second global LFO; it swells in over two and a half seconds into a long plate. Part B
# is the light above it: three triangles an octave up through a band-pass that drifts on its
# own 33-second LFO, arriving six seconds into the note and leaving last.
parts = layer
g1 = VA shape=saw oct=-2 level=0.55
g2 = VA shape=sine oct=-1 rand=0 level=0.7
p1 = Ladder cutoff=400 res=0.2 key=0.3 bass=0.7
env1 = attack=2500 decay=2000 sustain=1 release=4500
glfo1 = shape=sine sync=off rate=0.05 retrigger=off
mod = src=glfo1 dst=p1.cutoff amount=0.15
voice = env2ToP1=0 drift=3
b.g1 = VA shape=triangle oct=1 unison=3 detune=18 spread=1 level=0.6
b.p1 = SVF mode=bp cutoff=1800 res=0.2 key=0.5
b.env1 = attack=6000 decay=3000 sustain=0.8 release=6500
b.glfo1 = shape=sine sync=off rate=0.03 retrigger=off
b.mod = src=glfo1 dst=p1.cutoff amount=0.2
b.voice = env2ToP1=0 drift=5
b.mix = level=-8
reverb = on size=0.85 damping=0.5 mix=0.3
master = -5.5

[Shimmer Drone]
room = Observatory
# A dark saw and sine held under a plate that sends its own tail back an octave higher, again
# and again, so a haze of rising octaves hangs above every note.
g1 = VA shape=saw level=0.5
g2 = VA shape=sine rand=0 level=0.6
p1 = SVF mode=lp cutoff=1800 res=0.1 key=0.3
env1 = attack=1500 decay=2000 sustain=1 release=5000
voice = env2ToP1=0 drift=3
reverb = on size=0.85 damping=0.35 mix=0.45 predelay=40 lowcut=120 shimmer=0.6
master = -11

[Satellite Ping]
room = Observatory
# High sine blips two octaves up, a third of the eighth notes at random over two octaves, into a
# dotted-quarter ping-pong echo and a large plate. The one Observatory sound that starts at once.
g1 = VA shape=sine oct=2 rand=0 level=0.8
p1 = Off
env1 = attack=1 decay=150 sustain=0 release=150 velocity=0.4
voice = env2ToP1=0
arp = on rate=1/8 pattern=random octaves=2 gate=0.5 chance=0.35
delay = on sync=on division=1/4. mode=pingpong feedback=0.7 mix=0.35
reverb = on size=0.8 damping=0.4 mix=0.35 predelay=60
master = 6

[Granular Sky]
room = Observatory
# A cloud of grains from a bowed glass, frozen on one spot of the sample: forty grains a second,
# a quarter of a second each, scattered around the spot and across the stereo field, never more
# than five cents apart. A thinner cloud an octave up drifts slowly through the sample, and the
# glass itself hums quietly underneath. It swells in over two seconds into the long plate.
g1 = Grain sample=glass pos=0.3 scan=0 size=250 density=40 spray=0.35 pitch=0.065 spread=0.9 level=0.8
g2 = Grain sample=glass pos=0.6 scan=0.1 size=180 density=10 spray=0.5 pitch=0.065 spread=1 oct=1 level=0.4
g3 = Sample sample=glass loop=on level=0.2
p1 = SVF mode=lp cutoff=6000 res=0.05 key=0.3
env1 = attack=2000 decay=2000 sustain=1 release=4000
voice = env2ToP1=0
reverb = on size=0.9 damping=0.4 mix=0.4 predelay=20 lowcut=150
master = 1.5
