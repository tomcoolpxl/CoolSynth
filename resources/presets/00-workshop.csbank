# Workshop: starting points. One generator, the filter wide open, short envelopes, no effects.
# Init Noise (noise generator, phase 3.1), Init FM (FM generator, 3.2) and Init Wavetable (3.4) follow.

[Init Saw]
room = Workshop
g1 = VA shape=saw level=0.8
p1 = Ladder cutoff=20000 res=0 key=0 bass=0
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
master = -7

[Init Pulse]
room = Workshop
g1 = VA shape=pulse pw=0.5 level=0.8
p1 = Ladder cutoff=20000 res=0 key=0 bass=0
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
master = -13.5

[Init Sine]
room = Workshop
g1 = VA shape=sine level=0.8
p1 = Off
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
master = -9

[Init Arp]
room = Workshop
g1 = VA shape=saw level=0.8
p1 = Ladder cutoff=2400 res=0.2 key=0.5
env1 = attack=1 decay=180 sustain=0 release=120
env2 = attack=1 decay=160 sustain=0 release=120
voice = env2ToP1=0.25
arp = on rate=1/16 pattern=up octaves=2 gate=0.5
master = 6

[Init Noise]
room = Workshop
g1 = Noise type=white width=0.5 level=0.8
p1 = Ladder cutoff=20000 res=0 key=0 bass=0
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
master = -3.5

[Init FM]
room = Workshop
g1 = FM2 ratio=1 index=1 level=0.8
p1 = Ladder cutoff=20000 res=0 key=0 bass=0
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
master = -8

[Init Wavetable]
room = Workshop
g1 = Wavetable table=classic pos=0.667 level=0.8
p1 = Ladder cutoff=20000 res=0 key=0 bass=0
env1 = attack=2 decay=300 sustain=1 release=150
voice = env2ToP1=0
master = -5.5
