# Engine Room: one of each bass family, mono or legato, tight, no reverb.

[Pure Sub]
room = Engine Room
g1 = VA shape=sine level=0.9
p1 = Off
env1 = attack=2 decay=80 sustain=1 release=60 velocity=0.3
voice = env2ToP1=0
play = mode=legato
mix = level=-8.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Edge, (none), Release, Vibrato
macros = names=Edge,-,Release,Vibrato
mod = src=macro1 dst=g1.shape amount=0.12
mod = src=macro3 dst=env1.time amount=0.5
mod = src=lfo1 dst=pitch amount=0.004 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.36

[808 Boom]
room = Engine Room
# A sine two octaves under the key whose pitch falls 24 semitones in its first 60 ms, the punch
# of a modern 808 bass. Both envelopes run to the end whatever the key does; overlapping keys
# slide without restarting the boom.
g1 = VA shape=sine oct=-2 rand=0 level=0.9
p1 = Off
env1 = attack=0.5 decay=1400 sustain=0 release=1400 velocity=0.3 decayCurve=-0.5 oneShot=on
env3 = attack=0.5 decay=60 sustain=0 release=60 decayCurve=-0.7 oneShot=on
mod = src=env3 dst=pitch amount=0.5
voice = env2ToP1=0 glide=70
play = mode=legato glideLegato=on
i1 = Drive amount=0.3 mix=0.5
mix = level=-10.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Edge, Punch, Decay, Vibrato
macros = names=Edge,Punch,Decay,Vibrato
mod = src=macro1 dst=g1.shape amount=0.1
mod = src=env3 dst=pitch amount=0.125 via=macro2
mod = src=macro3 dst=env1.time amount=0.3
mod = src=lfo1 dst=pitch amount=0.004 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.36
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro1 dst=i1.mix amount=0.2

[Wobble]
room = Engine Room
# Two detuned saws an octave down through a resonant ladder whose cutoff an LFO sweeps at 1/8
# of the tempo, starting closed at every new note; legato notes keep the wobble going. The mod
# wheel doubles the wobble rate.
g1 = VA shape=saw oct=-1 fine=-6 level=0.75
g2 = VA shape=saw oct=-1 fine=6 level=0.75
p1 = Ladder cutoff=150 res=0.5 drive=6 key=0.3 bass=0.7
env1 = attack=2 decay=300 sustain=1 release=90 velocity=0.2
lfo1 = shape=triangle sync=on division=1/8 phase=270 retrigger=on
mod = src=lfo1 dst=p1.cutoff amount=0.5 curve=unipolar
mod = src=wheel dst=lfo1.rate amount=0.25
voice = env2ToP1=0 glide=25
play = mode=legato glideLegato=on
i1 = Drive amount=0.25 mix=0.6
mix = level=-15.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Bright, Grit, Release, Speed
macros = names=Bright,Grit,Release,Speed
mod = src=macro1 dst=p1.cutoff amount=0.1
mod = src=macro2 dst=p1.res amount=0.2
mod = src=macro2 dst=p1.drive amount=0.25
mod = src=macro3 dst=env1.time amount=0.5
mod = src=macro4 dst=lfo1.rate amount=0.25
# Effect routes of the macros (drafted 2026-11-15 for the user's review, D179)
fx = src=macro2 dst=i1.amount amount=0.1

[FM Knock]
room = Engine Room
# A 1:1 FM bass an octave down whose index snaps from bright to round in 30 ms: the knock of
# the attack, then a warm tone under a gentle low-pass. Every note knocks again.
g1 = FM2 ratio=1 index=0.3 feedback=0.2 oct=-1 level=1
p1 = Ladder cutoff=1400 res=0.15 key=0.4 bass=0.6
env1 = attack=1 decay=380 sustain=0.7 release=90 velocity=0.4
env3 = attack=0.5 decay=30 sustain=0 release=30
mod = src=env3 dst=g1.index amount=0.6
mod = src=velocity dst=g1.index amount=0.15
voice = env2ToP1=0
play = mode=mono
mix = level=-3.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Bright, Growl, Length, Wah
macros = names=Bright,Growl,Length,Wah
mod = src=macro1 dst=p1.cutoff amount=0.12
mod = src=macro2 dst=g1.index amount=0.1
mod = src=macro2 dst=g1.feedback amount=0.2
mod = src=macro3 dst=env3.time amount=0.4
mod = src=macro3 dst=env1.time amount=0.3
mod = src=lfo1 dst=g1.index amount=0.1 curve=unipolar via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.25

[Donk]
room = Engine Room
g1 = VA shape=pulse pw=0.5 oct=-1 level=0.8
p1 = Ladder cutoff=140 res=0.72 key=0.5 bass=0.6
env1 = attack=0.5 decay=260 sustain=0.55 release=80 velocity=0.5
env2 = attack=0.5 decay=130 sustain=0 release=90 decayCurve=-0.8
voice = env2ToP1=0.52 velToP1=0.12
play = mode=mono
mix = level=-3.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Bright, Ring, Decay, Wobble
macros = names=Bright,Ring,Decay,Wobble
mod = src=macro1 dst=p1.cutoff amount=0.08
mod = src=macro2 dst=p1.res amount=0.1
mod = src=macro3 dst=env2.time amount=0.4
mod = src=macro3 dst=env1.time amount=0.2
mod = src=lfo1 dst=p1.cutoff amount=0.06 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.25

[Fat Analog]
room = Engine Room
g1 = VA shape=saw unison=3 detune=18 spread=0.4 mix=0.6 sub=0.5 level=0.8
p1 = Ladder cutoff=520 res=0.22 key=0.4 drive=3 bass=0.7
env1 = attack=2 decay=320 sustain=1 release=90 velocity=0.4
env2 = attack=2 decay=360 sustain=0.3 release=150
voice = env2ToP1=0.3 glide=20 drift=2
play = mode=legato priority=low glideLegato=on
mix = level=-5.5
master = 0
# Macros (drafted 2026-11-15 for the user's review, D177): Bright, Thickness, Decay, Vibrato
macros = names=Bright,Thickness,Decay,Vibrato
mod = src=macro1 dst=p1.cutoff amount=0.12
mod = src=macro2 dst=g1.detune amount=0.12
mod = src=macro2 dst=p1.drive amount=0.25
mod = src=macro3 dst=env2.time amount=0.4
mod = src=macro3 dst=env1.time amount=0.4
mod = src=lfo1 dst=pitch amount=0.006 via=macro4
mod = src=macro4 dst=lfo1.rate amount=0.36

[Succession 808]
room = Engine Room
# The TR-808 under the Succession theme, as a sound-alike: no source gives its settings (D232).
# The Kick generator's 808, its circuit (D236): the attack jumps up for 6 ms and then sighs down
# almost three semitones onto the note. Played at C4 it rings on C2, the theme's C minor root;
# Ab, F and G play its other roots. Mono, so each hit strikes the drum still ringing; harder
# hits punch and sigh more. A boom of 1.3 s, about three beats at 140 BPM, darkened and driven.
# Drafted 2026-11-20 for the user's ears. Tone 0.17 since D251, where the refitted taper leaves VR5 as 0.35 did.
# Accent 0.78 since D258 (the trigger 4.7 to 11.5 V): its top at full velocity stays the 10 V it was passed at.
g1 = Kick model=808 decay=1300 punch=12 ptime=6 sigh=2.7 click=0.2 noise=0 shape=0.2 accent=0.78 drive=6 tone=0.17 trig=oneshot oct=-2 level=0.9
p1 = Off
env1 = attack=0.5 decay=1 sustain=1 release=40 velocity=0
voice = env2ToP1=0
play = mode=mono
i1 = Drive amount=0.25 mix=0.4
mix = level=-8
master = 2.5
# Macros (drafted 2026-11-20 for the user's review, in the bank's order: tone, character, time, movement): Tone, Punch, Boom, Grit
macros = names=Tone,Punch,Boom,Grit
mod = src=macro1 dst=g1.tone amount=0.4
mod = src=macro2 dst=g1.punch amount=0.25
mod = src=macro3 dst=g1.decay amount=0.2
mod = src=macro4 dst=g1.drive amount=0.5
