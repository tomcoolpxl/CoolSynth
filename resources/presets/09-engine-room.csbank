# Engine Room: one of each bass family, mono or legato, tight, no reverb.

[Pure Sub]
room = Engine Room
g1 = VA shape=sine level=0.9
p1 = Off
env1 = attack=2 decay=80 sustain=1 release=60 velocity=0.3
voice = env2ToP1=0
play = mode=legato
master = -6.5

[808 Boom]
room = Engine Room
# A sine two octaves under the key whose pitch falls 24 semitones in its first 60 ms, the punch
# of a modern 808 bass. Both envelopes run to the end whatever the key does; overlapping keys
# slide without restarting the boom.
g1 = VA shape=sine oct=-2 rand=0 level=0.9
p1 = Off
env1 = attack=0.5 decay=1400 sustain=0 release=1400 velocity=0.3 decayCurve=-0.5 oneShot=on
env3 = attack=0.5 decay=60 sustain=0 release=60 decayCurve=-0.7 oneShot=on
mod = src=env3 dst=pitch amount=0.5
voice = env2ToP1=0 glide=70
play = mode=legato glideLegato=on
f1 = Drive amount=0.3 mix=0.5
master = -1

[Wobble]
room = Engine Room
# Two detuned saws an octave down through a resonant ladder whose cutoff an LFO sweeps at 1/8
# of the tempo, starting closed at every new note; legato notes keep the wobble going. The mod
# wheel doubles the wobble rate.
g1 = VA shape=saw oct=-1 fine=-6 level=0.75
g2 = VA shape=saw oct=-1 fine=6 level=0.75
p1 = Ladder cutoff=150 res=0.5 drive=6 key=0.3 bass=0.7
env1 = attack=2 decay=300 sustain=1 release=90 velocity=0.2
lfo1 = shape=triangle sync=on division=1/8 phase=270 retrigger=on
mod = src=lfo1 dst=p1.cutoff amount=0.5 curve=unipolar
mod = src=wheel dst=lfo1.rate amount=0.25
voice = env2ToP1=0 glide=25
play = mode=legato glideLegato=on
f1 = Drive amount=0.25 mix=0.6
master = -12

[FM Knock]
room = Engine Room
# A 1:1 FM bass an octave down whose index snaps from bright to round in 30 ms: the knock of
# the attack, then a warm tone under a gentle low-pass. Every note knocks again.
g1 = FM2 ratio=1 index=0.3 feedback=0.2 oct=-1 level=1
p1 = Ladder cutoff=1400 res=0.15 key=0.4 bass=0.6
env1 = attack=1 decay=380 sustain=0.7 release=90 velocity=0.4
env3 = attack=0.5 decay=30 sustain=0 release=30
mod = src=env3 dst=g1.index amount=0.6
mod = src=velocity dst=g1.index amount=0.15
voice = env2ToP1=0
play = mode=mono
master = 1

[Donk]
room = Engine Room
g1 = VA shape=pulse pw=0.5 oct=-1 level=0.8
p1 = Ladder cutoff=140 res=0.72 key=0.5 bass=0.6
env1 = attack=0.5 decay=260 sustain=0.55 release=80 velocity=0.5
env2 = attack=0.5 decay=130 sustain=0 release=90 decayCurve=-0.8
voice = env2ToP1=0.52 velToP1=0.12
play = mode=mono
master = 0.5

[Fat Analog]
room = Engine Room
g1 = VA shape=saw unison=3 detune=18 spread=0.4 mix=0.6 sub=0.5 level=0.8
p1 = Ladder cutoff=520 res=0.22 key=0.4 drive=3 bass=0.7
env1 = attack=2 decay=320 sustain=1 release=90 velocity=0.4
env2 = attack=2 decay=360 sustain=0.3 release=150
voice = env2ToP1=0.3 glide=20 drift=2
play = mode=legato priority=low glideLegato=on
master = -2.5
